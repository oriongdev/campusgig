digraph "uc02" {
  graph [rankdir=TB, fontname="Inter", fontsize=13, labelloc=t, labeljust=l, label=<<b>UC2  Employer registers an account</b>>, pad=0.25, nodesep=0.35, ranksep=0.42, splines=spline, bgcolor="white", newrank=true, fontcolor="#1B2B45"];
  node [fontname="Inter", fontcolor="#1B2B45", penwidth=1.1];
  edge [fontname="Inter", fontsize=9.5, color="#1B2B45", fontcolor="#33425C", arrowsize=0.7, penwidth=1.0];
  subgraph cluster_emp {
    label=<<b>Employer</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#EEF4FF"; color="#B8C4D6"; margin=14;
    emp__top [shape=point, style=invis, width=0, height=0, label=""];
    emp__bot [shape=point, style=invis, width=0, height=0, label=""];
    s [shape=circle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.24, height=0.24, fixedsize=true];
    fill [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Enter company name and\nemail", fontsize=10.5, margin="0.14,0.08"];
    see [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="See the new account", fontsize=10.5, margin="0.14,0.08"];
    e [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
  }
  subgraph cluster_user {
    label=<<b>user-service</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F5F7FA"; color="#B8C4D6"; margin=14;
    user__top [shape=point, style=invis, width=0, height=0, label=""];
    user__bot [shape=point, style=invis, width=0, height=0, label=""];
    valid [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Name and email\nvalid?", fontsize=10, margin="0.16,0.10"];
    dup [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Email already\nregistered?", fontsize=10, margin="0.16,0.10"];
    err [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return the error with\nits reason", fontsize=10.5, margin="0.14,0.08"];
    ex [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
    save [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Save the Employer", fontsize=10.5, margin="0.14,0.08"];
    ok [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return 201 with the\naccount", fontsize=10.5, margin="0.14,0.08"];
  }
  { rank=min; emp__top; user__top; }
  { rank=max; emp__bot; user__bot; }
  emp__top -> user__top [style=invis];
  emp__top -> emp__bot [style=invis, weight=0];
  user__top -> user__bot [style=invis, weight=0];
  s -> fill;
  fill -> valid;
  valid -> err [label=" no: 400 "];
  valid -> dup [label=" yes "];
  dup -> err [label=" yes: 409 "];
  dup -> save [label=" no "];
  save -> ok;
  ok -> see;
  see -> e;
  err -> ex;
}
