digraph "uc11" {
  graph [rankdir=TB, fontname="Inter", fontsize=13, labelloc=t, labeljust=l, label=<<b>UC11  Real-time analysis: jobs posted per category</b>>, pad=0.25, nodesep=0.35, ranksep=0.42, splines=spline, bgcolor="white", newrank=true, fontcolor="#1B2B45"];
  node [fontname="Inter", fontcolor="#1B2B45", penwidth=1.1];
  edge [fontname="Inter", fontsize=9.5, color="#1B2B45", fontcolor="#33425C", arrowsize=0.7, penwidth=1.0];
  subgraph cluster_job {
    label=<<b>job-service</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F5F7FA"; color="#B8C4D6"; margin=14;
    job__top [shape=point, style=invis, width=0, height=0, label=""];
    job__bot [shape=point, style=invis, width=0, height=0, label=""];
    s [shape=circle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.24, height=0.24, fixedsize=true];
    pub [shape=cds, style=filled, fillcolor="#DFF7F2", color="#0E7490", label="Publish JobPosted", fontsize=10.5, margin="0.18,0.08"];
  }
  subgraph cluster_streams {
    label=<<b>matching-service: Kafka Streams</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F0FAF7"; color="#B8C4D6"; margin=14;
    streams__top [shape=point, style=invis, width=0, height=0, label=""];
    streams__bot [shape=point, style=invis, width=0, height=0, label=""];
    read [shape=box, style="filled,rounded,dashed", fillcolor="#DFF7F2", color="#0E7490", label="Read the event from\nthe job-posted topic", fontsize=10.5, margin="0.14,0.08"];
    hascat [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Has a category?", fontsize=10, margin="0.16,0.10"];
    skip [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Ignore the event", fontsize=10.5, margin="0.14,0.08"];
    ex [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
    rekey [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Re-key the event by its\ncategory", fontsize=10.5, margin="0.14,0.08"];
    count [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Add one to that\ncategory's count", fontsize=10.5, margin="0.14,0.08"];
    store [shape=cylinder, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="jobs-per-category-\nstore", fontsize=10, margin="0.08,0.06"];
  }
  subgraph cluster_api {
    label=<<b>matching-service: REST</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F5F7FA"; color="#B8C4D6"; margin=14;
    api__top [shape=point, style=invis, width=0, height=0, label=""];
    api__bot [shape=point, style=invis, width=0, height=0, label=""];
    ready [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="State store ready\nto query?", fontsize=10, margin="0.16,0.10"];
    q [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Read every category and\ncount from the store", fontsize=10.5, margin="0.14,0.08"];
    fallback [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Read the in-memory\ncounters instead", fontsize=10.5, margin="0.14,0.08"];
    ret [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return the counts", fontsize=10.5, margin="0.14,0.08"];
  }
  subgraph cluster_op {
    label=<<b>Platform operator</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#EEF4FF"; color="#B8C4D6"; margin=14;
    op__top [shape=point, style=invis, width=0, height=0, label=""];
    op__bot [shape=point, style=invis, width=0, height=0, label=""];
    s2 [shape=circle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.24, height=0.24, fixedsize=true];
    open [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Open the Live analytics\ntab", fontsize=10.5, margin="0.14,0.08"];
    see [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="See a bar per category,\nrefreshed every 5\nseconds", fontsize=10.5, margin="0.14,0.08"];
    e [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
  }
  { rank=min; job__top; streams__top; api__top; op__top; }
  { rank=max; job__bot; streams__bot; api__bot; op__bot; }
  job__top -> streams__top -> api__top -> op__top [style=invis];
  job__top -> job__bot [style=invis, weight=0];
  streams__top -> streams__bot [style=invis, weight=0];
  api__top -> api__bot [style=invis, weight=0];
  op__top -> op__bot [style=invis, weight=0];
  s -> pub;
  pub -> read [label=" Kafka ", style=dashed, color="#0E7490", arrowhead=open];
  read -> hascat;
  hascat -> skip [label=" no "];
  skip -> ex;
  hascat -> rekey [label=" yes "];
  rekey -> count;
  count -> store;
  s2 -> open;
  open -> ready;
  ready -> q [label=" yes "];
  ready -> fallback [label=" no "];
  q -> ret;
  fallback -> ret;
  store -> q [label=" interactive query ", style=dashed, color="#0E7490", arrowhead=open];
  ret -> see;
  see -> e;
}
