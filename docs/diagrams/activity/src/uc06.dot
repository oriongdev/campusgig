digraph "uc06" {
  graph [rankdir=TB, fontname="Inter", fontsize=13, labelloc=t, labeljust=l, label=<<b>UC6  Student searches for jobs</b>>, pad=0.25, nodesep=0.35, ranksep=0.42, splines=spline, bgcolor="white", newrank=true, fontcolor="#1B2B45"];
  node [fontname="Inter", fontcolor="#1B2B45", penwidth=1.1];
  edge [fontname="Inter", fontsize=9.5, color="#1B2B45", fontcolor="#33425C", arrowsize=0.7, penwidth=1.0];
  subgraph cluster_student {
    label=<<b>Student</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#EEF4FF"; color="#B8C4D6"; margin=14;
    student__top [shape=point, style=invis, width=0, height=0, label=""];
    student__bot [shape=point, style=invis, width=0, height=0, label=""];
    s [shape=circle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.24, height=0.24, fixedsize=true];
    filters [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Enter any of category,\nlocation and minimum pay", fontsize=10.5, margin="0.14,0.08"];
    found [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Any results?", fontsize=10, margin="0.16,0.10"];
    read [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Read the listings", fontsize=10.5, margin="0.14,0.08"];
    relax [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Change the filters", fontsize=10.5, margin="0.14,0.08"];
    e [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
  }
  subgraph cluster_job {
    label=<<b>job-service</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F5F7FA"; color="#B8C4D6"; margin=14;
    job__top [shape=point, style=invis, width=0, height=0, label=""];
    job__bot [shape=point, style=invis, width=0, height=0, label=""];
    load [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Load the jobs that are\nOPEN", fontsize=10.5, margin="0.14,0.08"];
    any [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Any filters given?", fontsize=10, margin="0.16,0.10"];
    filter [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Keep the jobs that match\nevery filter given", fontsize=10.5, margin="0.14,0.08"];
    ret [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return 200 with the list", fontsize=10.5, margin="0.14,0.08"];
  }
  { rank=min; student__top; job__top; }
  { rank=max; student__bot; job__bot; }
  student__top -> job__top [style=invis];
  student__top -> student__bot [style=invis, weight=0];
  job__top -> job__bot [style=invis, weight=0];
  s -> filters;
  filters -> load;
  load -> any;
  any -> filter [label=" yes "];
  any -> ret [label=" no "];
  filter -> ret;
  ret -> found;
  found -> read [label=" yes "];
  found -> relax [label=" no "];
  relax -> filters;
  read -> e;
}
