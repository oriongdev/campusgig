digraph "uc05" {
  graph [rankdir=TB, fontname="Inter", fontsize=13, labelloc=t, labeljust=l, label=<<b>UC5  Employer edits or closes a job</b>>, pad=0.25, nodesep=0.35, ranksep=0.42, splines=spline, bgcolor="white", newrank=true, fontcolor="#1B2B45"];
  node [fontname="Inter", fontcolor="#1B2B45", penwidth=1.1];
  edge [fontname="Inter", fontsize=9.5, color="#1B2B45", fontcolor="#33425C", arrowsize=0.7, penwidth=1.0];
  subgraph cluster_emp {
    label=<<b>Employer</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#EEF4FF"; color="#B8C4D6"; margin=14;
    emp__top [shape=point, style=invis, width=0, height=0, label=""];
    emp__bot [shape=point, style=invis, width=0, height=0, label=""];
    s [shape=circle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.24, height=0.24, fixedsize=true];
    pick [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Pick one of their jobs", fontsize=10.5, margin="0.14,0.08"];
    which [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Edit or close?", fontsize=10, margin="0.16,0.10"];
    edit [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Change the details and\nsave", fontsize=10.5, margin="0.14,0.08"];
    close [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Choose Close job", fontsize=10.5, margin="0.14,0.08"];
    see [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="See the change under My\njobs", fontsize=10.5, margin="0.14,0.08"];
    e [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
  }
  subgraph cluster_job {
    label=<<b>job-service</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F5F7FA"; color="#B8C4D6"; margin=14;
    job__top [shape=point, style=invis, width=0, height=0, label=""];
    job__bot [shape=point, style=invis, width=0, height=0, label=""];
    found [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Job exists?", fontsize=10, margin="0.16,0.10"];
    open [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Job still open?", fontsize=10, margin="0.16,0.10"];
    err [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return the error with\nits reason", fontsize=10.5, margin="0.14,0.08"];
    ex [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
    action [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Edit or close?", fontsize=10, margin="0.16,0.10"];
    upd [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Check the new details\nand update the Job", fontsize=10.5, margin="0.14,0.08"];
    pubu [shape=cds, style=filled, fillcolor="#DFF7F2", color="#0E7490", label="Publish JobUpdated", fontsize=10.5, margin="0.18,0.08"];
    cls [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Mark the Job CLOSED with\nthe time", fontsize=10.5, margin="0.14,0.08"];
    pubc [shape=cds, style=filled, fillcolor="#DFF7F2", color="#0E7490", label="Publish JobClosed", fontsize=10.5, margin="0.18,0.08"];
    ok [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return 200 with the job", fontsize=10.5, margin="0.14,0.08"];
  }
  subgraph cluster_match {
    label=<<b>matching-service</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F0FAF7"; color="#B8C4D6"; margin=14;
    match__top [shape=point, style=invis, width=0, height=0, label=""];
    match__bot [shape=point, style=invis, width=0, height=0, label=""];
    snapu [shape=box, style="filled,rounded,dashed", fillcolor="#DFF7F2", color="#0E7490", label="Replace the\nJobSnapshot", fontsize=10.5, margin="0.14,0.08"];
    snapc [shape=box, style="filled,rounded,dashed", fillcolor="#DFF7F2", color="#0E7490", label="Delete the\nJobSnapshot, so the\njob is no longer\nrecommended", fontsize=10.5, margin="0.14,0.08"];
  }
  { rank=min; emp__top; job__top; match__top; }
  { rank=max; emp__bot; job__bot; match__bot; }
  emp__top -> job__top -> match__top [style=invis];
  emp__top -> emp__bot [style=invis, weight=0];
  job__top -> job__bot [style=invis, weight=0];
  match__top -> match__bot [style=invis, weight=0];
  s -> pick;
  pick -> which;
  which -> edit [label=" edit "];
  which -> close [label=" close "];
  edit -> found;
  close -> found;
  found -> err [label=" no: 404 "];
  found -> open [label=" yes "];
  open -> err [label=" no: 409 "];
  open -> action [label=" yes "];
  action -> upd [label=" edit "];
  action -> cls [label=" close "];
  upd -> pubu;
  pubu -> ok;
  cls -> pubc;
  pubc -> ok;
  ok -> see;
  see -> e;
  err -> ex;
  pubu -> snapu [label=" Kafka ", style=dashed, color="#0E7490", arrowhead=open];
  pubc -> snapc [label=" Kafka ", style=dashed, color="#0E7490", arrowhead=open];
}
