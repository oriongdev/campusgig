digraph "uc09" {
  graph [rankdir=TB, fontname="Inter", fontsize=13, labelloc=t, labeljust=l, label=<<b>UC9  Employer shortlists, accepts or rejects an applicant</b>>, pad=0.25, nodesep=0.35, ranksep=0.42, splines=spline, bgcolor="white", newrank=true, fontcolor="#1B2B45"];
  node [fontname="Inter", fontcolor="#1B2B45", penwidth=1.1];
  edge [fontname="Inter", fontsize=9.5, color="#1B2B45", fontcolor="#33425C", arrowsize=0.7, penwidth=1.0];
  subgraph cluster_emp {
    label=<<b>Employer</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#EEF4FF"; color="#B8C4D6"; margin=14;
    emp__top [shape=point, style=invis, width=0, height=0, label=""];
    emp__bot [shape=point, style=invis, width=0, height=0, label=""];
    s [shape=circle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.24, height=0.24, fixedsize=true];
    open [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Open the applicants for\na job", fontsize=10.5, margin="0.14,0.08"];
    choose [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Choose Shortlist, Accept\nor Reject", fontsize=10.5, margin="0.14,0.08"];
    see [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="See the new status on\nthe applicant", fontsize=10.5, margin="0.14,0.08"];
    e [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
  }
  subgraph cluster_app {
    label=<<b>application-service</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F5F7FA"; color="#B8C4D6"; margin=14;
    app__top [shape=point, style=invis, width=0, height=0, label=""];
    app__bot [shape=point, style=invis, width=0, height=0, label=""];
    list [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return the applications\nfor that job", fontsize=10.5, margin="0.14,0.08"];
    found [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Application\nexists?", fontsize=10, margin="0.16,0.10"];
    allowed [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Is the change\nallowed from its\ncurrent status?", fontsize=10, margin="0.16,0.10"];
    err [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return the error with\nits reason", fontsize=10.5, margin="0.14,0.08"];
    ex [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
    set [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Set the new status", fontsize=10.5, margin="0.14,0.08"];
    pub [shape=cds, style=filled, fillcolor="#DFF7F2", color="#0E7490", label="Publish\nApplicationStatusChanged\n(old and new status)", fontsize=10.5, margin="0.18,0.08"];
    ok [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return 200 with the\napplication", fontsize=10.5, margin="0.14,0.08"];
  }
  subgraph cluster_match {
    label=<<b>matching-service</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F0FAF7"; color="#B8C4D6"; margin=14;
    match__top [shape=point, style=invis, width=0, height=0, label=""];
    match__bot [shape=point, style=invis, width=0, height=0, label=""];
    note [shape=box, style="filled,rounded,dashed", fillcolor="#DFF7F2", color="#0E7490", label="Create a notification\nfor the student (UC10)", fontsize=10.5, margin="0.14,0.08"];
  }
  { rank=min; emp__top; app__top; match__top; }
  { rank=max; emp__bot; app__bot; match__bot; }
  emp__top -> app__top -> match__top [style=invis];
  emp__top -> emp__bot [style=invis, weight=0];
  app__top -> app__bot [style=invis, weight=0];
  match__top -> match__bot [style=invis, weight=0];
  s -> open;
  open -> list;
  list -> choose;
  choose -> found;
  found -> err [label=" no: 404 "];
  found -> allowed [label=" yes "];
  allowed -> err [label=" no: 409 "];
  allowed -> set [label=" yes "];
  set -> pub;
  pub -> ok;
  ok -> see;
  see -> e;
  err -> ex;
  pub -> note [label=" Kafka ", style=dashed, color="#0E7490", arrowhead=open];
}
