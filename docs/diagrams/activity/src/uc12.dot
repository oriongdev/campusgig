digraph "uc12" {
  graph [rankdir=TB, fontname="Inter", fontsize=13, labelloc=t, labeljust=l, label=<<b>UC12  Real-time analysis: applications per job and trending jobs</b>>, pad=0.25, nodesep=0.35, ranksep=0.42, splines=spline, bgcolor="white", newrank=true, fontcolor="#1B2B45"];
  node [fontname="Inter", fontcolor="#1B2B45", penwidth=1.1];
  edge [fontname="Inter", fontsize=9.5, color="#1B2B45", fontcolor="#33425C", arrowsize=0.7, penwidth=1.0];
  subgraph cluster_app {
    label=<<b>application-service</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F5F7FA"; color="#B8C4D6"; margin=14;
    app__top [shape=point, style=invis, width=0, height=0, label=""];
    app__bot [shape=point, style=invis, width=0, height=0, label=""];
    s [shape=circle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.24, height=0.24, fixedsize=true];
    pub [shape=cds, style=filled, fillcolor="#DFF7F2", color="#0E7490", label="Publish\nApplicationSubmitted", fontsize=10.5, margin="0.18,0.08"];
  }
  subgraph cluster_streams {
    label=<<b>matching-service: Kafka Streams</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F0FAF7"; color="#B8C4D6"; margin=14;
    streams__top [shape=point, style=invis, width=0, height=0, label=""];
    streams__bot [shape=point, style=invis, width=0, height=0, label=""];
    read [shape=box, style="filled,rounded,dashed", fillcolor="#DFF7F2", color="#0E7490", label="Read the event from\nthe application-\nsubmitted topic", fontsize=10.5, margin="0.14,0.08"];
    rekey [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Re-key the event by job\nid", fontsize=10.5, margin="0.14,0.08"];
    fork [shape=box, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=1.6, height=0.07, fixedsize=true];
    total [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Add one to the job's\ntotal", fontsize=10.5, margin="0.14,0.08"];
    window [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Add one to the job's\ncount for the current\n15-minute window", fontsize=10.5, margin="0.14,0.08"];
    tstore [shape=cylinder, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="applications-per-\njob-store", fontsize=10, margin="0.08,0.06"];
    wstore [shape=cylinder, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="trending-jobs-\nstore", fontsize=10, margin="0.08,0.06"];
  }
  subgraph cluster_api {
    label=<<b>matching-service: REST</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F5F7FA"; color="#B8C4D6"; margin=14;
    api__top [shape=point, style=invis, width=0, height=0, label=""];
    api__bot [shape=point, style=invis, width=0, height=0, label=""];
    q1 [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Read every job's total\nfrom the store", fontsize=10.5, margin="0.14,0.08"];
    q2 [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Read the windows that\nstarted in the last 15\nminutes", fontsize=10.5, margin="0.14,0.08"];
    keep [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Keep jobs with 2 or more\napplications and add\ntheir titles", fontsize=10.5, margin="0.14,0.08"];
    ret [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return the totals and\nthe trending jobs", fontsize=10.5, margin="0.14,0.08"];
  }
  subgraph cluster_op {
    label=<<b>Platform operator</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#EEF4FF"; color="#B8C4D6"; margin=14;
    op__top [shape=point, style=invis, width=0, height=0, label=""];
    op__bot [shape=point, style=invis, width=0, height=0, label=""];
    s2 [shape=circle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.24, height=0.24, fixedsize=true];
    open [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Open the Live analytics\ntab", fontsize=10.5, margin="0.14,0.08"];
    see [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="See applications per job\nand the jobs marked\ntrending", fontsize=10.5, margin="0.14,0.08"];
    e [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
  }
  { rank=min; app__top; streams__top; api__top; op__top; }
  { rank=max; app__bot; streams__bot; api__bot; op__bot; }
  app__top -> streams__top -> api__top -> op__top [style=invis];
  app__top -> app__bot [style=invis, weight=0];
  streams__top -> streams__bot [style=invis, weight=0];
  api__top -> api__bot [style=invis, weight=0];
  op__top -> op__bot [style=invis, weight=0];
  s -> pub;
  pub -> read [label=" Kafka ", style=dashed, color="#0E7490", arrowhead=open];
  read -> rekey;
  rekey -> fork;
  fork -> total;
  fork -> window;
  total -> tstore;
  window -> wstore;
  s2 -> open;
  open -> q1;
  q1 -> q2;
  q2 -> keep;
  keep -> ret;
  ret -> see;
  see -> e;
  tstore -> q1 [label=" interactive query ", style=dashed, color="#0E7490", arrowhead=open];
  wstore -> q2 [label=" interactive query ", style=dashed, color="#0E7490", arrowhead=open];
}
