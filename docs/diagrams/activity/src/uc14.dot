digraph "uc14" {
  graph [rankdir=TB, fontname="Inter", fontsize=13, labelloc=t, labeljust=l, label=<<b>UC14  AI assistant improves an employer&#x27;s draft job ad</b>>, pad=0.25, nodesep=0.35, ranksep=0.42, splines=spline, bgcolor="white", newrank=true, fontcolor="#1B2B45"];
  node [fontname="Inter", fontcolor="#1B2B45", penwidth=1.1];
  edge [fontname="Inter", fontsize=9.5, color="#1B2B45", fontcolor="#33425C", arrowsize=0.7, penwidth=1.0];
  subgraph cluster_emp {
    label=<<b>Employer</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#EEF4FF"; color="#B8C4D6"; margin=14;
    emp__top [shape=point, style=invis, width=0, height=0, label=""];
    emp__bot [shape=point, style=invis, width=0, height=0, label=""];
    s [shape=circle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.24, height=0.24, fixedsize=true];
    draft [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Draft a job ad and\nchoose Improve with AI", fontsize=10.5, margin="0.14,0.08"];
    see [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Check the improved ad,\nthen post it (UC4)", fontsize=10.5, margin="0.14,0.08"];
    e [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
  }
  subgraph cluster_match {
    label=<<b>matching-service</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#F5F7FA"; color="#B8C4D6"; margin=14;
    match__top [shape=point, style=invis, width=0, height=0, label=""];
    match__bot [shape=point, style=invis, width=0, height=0, label=""];
    conf [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="API key\nconfigured?", fontsize=10, margin="0.16,0.10"];
    err [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return the error with\nits reason", fontsize=10.5, margin="0.14,0.08"];
    ex [shape=doublecircle, style=filled, fillcolor="#1B2B45", color="#1B2B45", label="", width=0.2, height=0.2, fixedsize=true];
    ok1 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Call succeeded and\nreply readable?", fontsize=10, margin="0.16,0.10"];
    guard [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="JobAdGuard: is every\ndollar amount in the\nrewrite also in the\ndraft?", fontsize=10.5, margin="0.14,0.08"];
    issues [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#1B2B45", label="Any problems\nfound?", fontsize=10, margin="0.16,0.10"];
    ret [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Return the ad, the tips\nand the reviewer's notes", fontsize=10.5, margin="0.14,0.08"];
  }
  subgraph cluster_llm {
    label=<<b>Gemini (LLM)</b>>; labelloc=t; labeljust=c; fontsize=11.5; fontname="Inter"; fontcolor="#1B2B45";
    style="filled"; fillcolor="#FFF7E6"; color="#B8C4D6"; margin=14;
    llm__top [shape=point, style=invis, width=0, height=0, label=""];
    llm__bot [shape=point, style=invis, width=0, height=0, label=""];
    write [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Writer agent rewrites\nthe ad", fontsize=10.5, margin="0.14,0.08"];
    critic [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Critic agent compares\nthe rewrite with the\ndraft", fontsize=10.5, margin="0.14,0.08"];
    revise [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#1B2B45", label="Writer agent revises,\ngiven the problems", fontsize=10.5, margin="0.14,0.08"];
  }
  { rank=min; emp__top; match__top; llm__top; }
  { rank=max; emp__bot; match__bot; llm__bot; }
  emp__top -> match__top -> llm__top [style=invis];
  emp__top -> emp__bot [style=invis, weight=0];
  match__top -> match__bot [style=invis, weight=0];
  llm__top -> llm__bot [style=invis, weight=0];
  s -> draft;
  draft -> conf;
  conf -> err [label=" no: 503 "];
  conf -> write [label=" yes "];
  write -> ok1;
  ok1 -> err [label=" no: 502 "];
  ok1 -> guard [label=" yes "];
  err -> ex;
  guard -> critic;
  critic -> issues;
  issues -> revise [label=" yes "];
  issues -> ret [label=" no "];
  revise -> ret;
  ret -> see;
  see -> e;
}
