{
  "info": {
    "name": "CampusGig demo",
    "description": "Run in order against a fresh start of all four services (./run.sh). Requests 1-19 and 23-25 need no API key. Requests 21 and 22 call the AI agents and return 503 unless matching-service was started with GEMINI_API_KEY set. ./demo.sh runs the same flow from the command line and checks every response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "userUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "jobUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "appUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "matchUrl",
      "value": "http://localhost:8084"
    }
  ],
  "item": [
    {
      "name": "1. Register student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{userUrl}}/api/students",
          "host": [
            "{{userUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alex Nguyen\",\n  \"email\": \"alex@uowmail.edu.au\",\n  \"skills\": [\n    \"barista\",\n    \"customer service\",\n    \"java\"\n  ],\n  \"availability\": \"WEEKENDS\"\n}"
        }
      }
    },
    {
      "name": "2. Register employer",
