          "raw": "{\n  \"employerId\": 1,\n  \"title\": \"Weekend Barista\",\n  \"description\": \"Make coffee and handle customer service on Saturday mornings.\",\n  \"category\": \"hospitality\",\n  \"location\": \"Wollongong\",\n  \"payAmount\": 28.5,\n  \"payType\": \"HOURLY\"\n}"
        }
